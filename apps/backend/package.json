{
  "name": "asynkron-liveview-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Experimental Node.js port of the LiveView markdown backend.",
  "main": "src/index.js",
  "scripts": {
    "start": "node ./src/index.js",
    "dev": "NODE_ENV=development node ./src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.js\" \"tests/**/*.js\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" README.md",
    "format:fix": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" README.md"
  },
  "dependencies": {
    "@asynkron/openagent": "^2.13.11",
    "chokidar": "^3.5.3",
    "express": "^4.19.2",
    "ws": "^8.15.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "supertest": "^6.3.4",
    "vitest": "^1.6.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  }
}
