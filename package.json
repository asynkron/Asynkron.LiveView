{
  "name": "asynkron-liveview-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/frontend"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "format": "npm run format --workspaces --if-present",
    "format:fix": "npm run format:fix --workspaces --if-present",
    "test": "npm run test --workspaces",
    "test:ci": "npm run test --workspaces --if-present",
    "backend:start": "npm run start --workspace asynkron-liveview-backend",
    "backend:dev": "npm run dev --workspace asynkron-liveview-backend",
    "frontend:build": "npm run build --workspace asynkron-liveview-frontend",
    "start": "npm install --workspace asynkron-liveview-frontend && npm run build --workspace asynkron-liveview-frontend && npm install --workspace asynkron-liveview-backend && npm run start --workspace asynkron-liveview-backend -- --port 8080"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.8.0",
    "prettier": "^3.3.3"
  }
}
